{
  "description": "Capa firmware del arnés: anuncia la capa e inyecta sus reglas al empezar la sesión, y pide confirmación antes de editar archivos generados.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/anunciar.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/proteger_generados.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
